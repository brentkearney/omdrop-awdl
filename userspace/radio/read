#!/usr/bin/env bash
# Radio backend hook `read <iovar> [len]` (omdrop-core's
# docs/backend-contract.md), Broadcom: one GET of an AWDL iovar, hexdumped.
# Limited to awdl_* iovars, ver and cap, and len to 8192: other iovars carry
# the Wi-Fi network's credentials.
#
# Exit 0: hexdump printed.
#      2: usage, a refused iovar or length, or not root.
#      4: no reply (unsupported, or AWDL disabled).
set -uo pipefail
# pkexec and core may hand us any umask; what this creates in the run
# directory must be writable by root alone.
umask 022
# The library and the Python helpers sit one directory up: /usr/lib/omdrop when
# packaged. Resolved from our own realpath, never the working directory.
LIB="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=../omdrop-broadcom.sh
. "$LIB/omdrop-broadcom.sh" || { echo "$0: cannot read $LIB/omdrop-broadcom.sh" >&2; exit 2; }
hook_mode
(( $# <= 2 )) || die 2 "usage: $0 <iovar> [len]"
cmd_read "$@"
